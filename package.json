{
  "name": "@attention-spa/gh-plan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:normalization": "node --experimental-strip-types tests/normalize.test.ts",
    "test:rest": "node --experimental-strip-types tests/rest-discovery.test.ts && node --experimental-strip-types tests/rest-global-fetch.test.ts && node --experimental-strip-types tests/rest-token-safety.test.ts && node --experimental-strip-types tests/discovery.test.ts",
    "test:identity": "node --experimental-strip-types tests/identity.test.ts",
    "test": "npm run typecheck && npm run test:normalization && npm run test:rest && npm run test:identity && npm run test:diff && npm run test:bindings && npm run test:execute && npm run test:recovery && npm run test:verification && npm run test:replay && npm run test:apply-preflight && npm run test:apply-contract && npm run test:milestone-reader && npm run test:issue-reader && npm run test:cas-lock && npm run test:cas-recovery && npm run test:ci-fallback && npm run test:bootstrap-fallback && npm run test:milestones && npm run test:issues && npm run test:issue-fields && npm run test:relationships && npm run test:plan && npm run test:labels && npm run test:assignees && npm run test:repository-labels && npm run test:schema && npm run test:knowledge && npm run test:knowledge-examples && npm run test:readme && npm run test:pr && npm run test:projects && npm run test:milestone-due && npm run test:prune",
    "test:diff": "node --experimental-strip-types tests/diff.test.ts",
    "test:bindings": "node --experimental-strip-types tests/plan-bindings.test.ts",
    "test:execute": "node --experimental-strip-types tests/execute-steps.test.ts",
    "test:recovery": "node --experimental-strip-types tests/issue-create-recovery.test.ts",
    "test:verification": "node --experimental-strip-types tests/postwrite-verification.test.ts",
    "test:replay": "node --experimental-strip-types tests/apply-replay.test.ts",
    "test:apply-preflight": "node --experimental-strip-types tests/apply-preflight.test.ts",
    "test:apply-contract": "node --experimental-strip-types tests/apply-contract.test.ts",
    "test:milestone-reader": "node --experimental-strip-types tests/milestone-postcondition-reader.test.ts",
    "test:issue-reader": "node --experimental-strip-types tests/issue-postcondition-reader.test.ts",
    "test:cas-lock": "node --experimental-strip-types tests/github-cas-lock.test.ts",
    "test:cas-recovery": "node --experimental-strip-types tests/github-cas-recovery.test.ts",
    "test:ci-fallback": "node tests/ci-fallback-controller.test.mjs",
    "test:bootstrap-fallback": "node tests/bootstrap-fallback.test.mjs",
    "test:milestones": "node --experimental-strip-types tests/milestone-compiler.test.ts",
    "test:issues": "node --experimental-strip-types tests/issue-compiler.test.ts",
    "test:issue-fields": "node --experimental-strip-types tests/issue-field-compiler.test.ts",
    "test:relationships": "node --experimental-strip-types tests/relationship-compiler.test.ts",
    "test:plan": "node --experimental-strip-types tests/plan.test.ts",
    "test:labels": "node --experimental-strip-types tests/labels.test.ts",
    "test:assignees": "node --experimental-strip-types tests/assignees.test.ts",
    "test:repository-labels": "node --experimental-strip-types tests/repository-labels.test.ts",
    "test:dist": "node tests/dist-import.test.mjs",
    "schema:generate": "node scripts/generate-schema.mjs --write",
    "schema:check": "node scripts/generate-schema.mjs --check",
    "test:schema": "node tests/schema.test.mjs",
    "test:knowledge": "node tests/knowledge.test.mjs",
    "test:knowledge-examples": "node --experimental-strip-types tests/knowledge-examples.test.mjs",
    "docs:readme": "node --experimental-strip-types scripts/readme.ts --write",
    "docs:check": "node --experimental-strip-types scripts/readme.ts --check && npm run test:knowledge && npm run test:knowledge-examples && npm run test:readme",
    "test:readme": "node --experimental-strip-types tests/readme.test.mjs",
    "test:pr": "node --experimental-strip-types tests/pull-requests.test.ts",
    "test:projects": "node --experimental-strip-types tests/projects.test.ts",
    "test:milestone-due": "node --experimental-strip-types tests/milestone-due-on.test.ts",
    "test:prune": "node --experimental-strip-types tests/prune.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "ts-json-schema-generator": "2.9.0",
    "ajv": "8.17.1",
    "yaml": "2.8.1"
  }
}
