{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/attention-spa/gh-plan/main/schema/gh-plan.schema.json",
  "$ref": "#/$defs/GithubPlanSchema",
  "$defs": {
    "GithubPlanSchema": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Editor schema hint; ignored by the planner when a string."
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "fullName": {
                  "type": "string"
                },
                "id": {
                  "type": "number"
                },
                "nodeId": {
                  "type": "string"
                }
              },
              "required": [
                "fullName"
              ],
              "additionalProperties": false
            }
          ],
          "description": "owner/name shorthand or repository identity object."
        },
        "prune": {
          "type": "string",
          "enum": [
            "report",
            "close"
          ],
          "description": "Default report-only orphan/duplicate diagnostics; close is an explicit opt-in."
        },
        "deleteDuplicates": {
          "type": "boolean",
          "description": "Permanent deletion is a separate explicit, GraphQL-only duplicate opt-in."
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringIssue"
          },
          "description": "Optional managed/reference issue trees."
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringPullRequest"
          },
          "description": "Managed pull requests, identified by open head/base pairs. Merging is not supported."
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringMilestone"
          },
          "description": "Optional milestones keyed by logical ID."
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringProjectReference"
          },
          "description": "Existing Projects v2 boards only. Does not create projects or fields."
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringRepositoryLabel"
          },
          "description": "Optional repository-label declarations; omitted labels never imply deletion."
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringRelationship"
          },
          "description": "Native directed and symmetric relationship declarations."
        },
        "relationshipMode": {
          "type": "string",
          "enum": [
            "reconcile",
            "additive"
          ],
          "description": "Defaults reconcile; additive preserves relationships not named in the schema."
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false,
      "description": "Public ergonomic planGithub() input. Fields omitted from managed resources are not touched. Nested children flatten into parent edges; cross-resource validity is checked at runtime. A string $schema value is an editor hint, not a transport instruction."
    },
    "AuthoringIssue": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthoringManagedIssue"
        },
        {
          "$ref": "#/$defs/AuthoringReferencedIssue"
        }
      ],
      "description": "Discriminated managed-or-reference issue declaration, optionally nested via children."
    },
    "AuthoringManagedIssue": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "managed"
        },
        "identity": {
          "$ref": "#/$defs/AuthoringIdentity"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3Cstring%3E"
            }
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSetOrRemove%3Cstring%3E"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "const": "open"
            },
            {
              "type": "string",
              "const": "closed"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3C(%22open%22%7C%22closed%22)%3E"
            }
          ]
        },
        "milestone": {
          "$ref": "#/$defs/AuthoringMilestoneRef"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3Cstring%3E"
            }
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/AuthoringJson"
              },
              {
                "$ref": "#/$defs/AuthoringSet%3CAuthoringJson%3E"
              },
              {
                "$ref": "#/$defs/AuthoringRemove"
              }
            ]
          },
          "description": "Organization issue fields keyed by field name; value or explicit set/remove."
        },
        "labels": {
          "$ref": "#/$defs/AuthoringIssueLabels",
          "description": "Omitted leaves existing issue labels intact; exact set or targeted add/remove."
        },
        "assignees": {
          "$ref": "#/$defs/AuthoringIssueAssignees",
          "description": "GitHub logins; assignment eligibility is checked by GET during discovery."
        },
        "projects": {
          "$ref": "#/$defs/AuthoringProjectAssignments",
          "description": "Add/reconcile this issue's membership and field values in declared existing Projects v2."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringIssue"
          },
          "description": "Nested children create directed parent links; nested reference-only issues are allowed."
        },
        "blockedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Logical IDs of issues that block this issue (incoming dependency edges)."
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Logical IDs of issues blocked by this issue (outgoing dependency edges)."
        },
        "relatesTo": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Undirected associations to other issue logical IDs."
        }
      },
      "required": [
        "logicalId"
      ],
      "additionalProperties": false,
      "description": "Managed issue: requested properties are reconciled; absent properties are not touched. Type and organization fields use display names, not REST IDs."
    },
    "AuthoringIdentity": {
      "type": "object",
      "properties": {
        "number": {
          "type": "number"
        },
        "id": {
          "type": "number"
        },
        "nodeId": {
          "type": "string"
        },
        "marker": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Optional exact identity clues: REST id, node id, issue number and body marker. Explicit IDs precede marker/title lookup and must agree."
    },
    "AuthoringSet<string>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringSetOrRemove<string>": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthoringSet%3Cstring%3E"
        },
        {
          "$ref": "#/$defs/AuthoringRemove"
        }
      ],
      "description": "Set or clear form for body, description and other removable properties."
    },
    "AuthoringRemove": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "remove"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "description": "Explicitly clear a supported nullable property."
    },
    "AuthoringSet<(\"open\"|\"closed\")>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringMilestoneRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/AuthoringLogicalRef"
        },
        {
          "$ref": "#/$defs/AuthoringSet%3C(string%7CAuthoringLogicalRef)%3E"
        },
        {
          "$ref": "#/$defs/AuthoringRemove"
        }
      ],
      "description": "Milestone assignment shorthand: logical ID, logical reference, explicit set or remove."
    },
    "AuthoringLogicalRef": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        }
      },
      "required": [
        "logicalId"
      ],
      "additionalProperties": false,
      "description": "Logical resource pointer used for future and existing milestone assignment."
    },
    "AuthoringSet<(string|AuthoringLogicalRef)>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringLogicalRef"
            }
          ]
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringJson": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthoringJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AuthoringJson"
          }
        }
      ],
      "description": "JSON-serializable field payload; a remove operation is separate from JSON null."
    },
    "AuthoringSet<AuthoringJson>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "$ref": "#/$defs/AuthoringJson"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringIssueLabels": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/AuthoringSet%3Cstring%5B%5D%3E"
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "add"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "remove"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Exact labels array or set operation; add/remove only change named labels, preserving others. Omission leaves labels untouched."
    },
    "AuthoringSet<string[]>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringIssueAssignees": {
      "$ref": "#/$defs/AuthoringIssueLabels",
      "description": "GitHub login assignment using the same exact/incremental forms as labels. Omission never unassigns collaborators."
    },
    "AuthoringProjectAssignments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "description": "Optional Projects v2 membership, keyed by a declared project logicalId. An empty map adds membership only. Values are raw text/number/date or option/iteration names, resolved against existing fields."
    },
    "AuthoringReferencedIssue": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "reference"
        },
        "identity": {
          "$ref": "#/$defs/AuthoringIdentity"
        },
        "projects": {
          "$ref": "#/$defs/AuthoringProjectAssignments",
          "description": "Referenced existing issues may still be added to Projects v2 without changing the issue itself."
        }
      },
      "required": [
        "logicalId",
        "management"
      ],
      "additionalProperties": false,
      "description": "Existing issue reference for relationships only; authoring a title or other desired state is prohibited."
    },
    "AuthoringPullRequest": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/AuthoringIdentity"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3Cstring%3E"
            }
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSetOrRemove%3Cstring%3E"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "const": "open"
            },
            {
              "type": "string",
              "const": "closed"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3C(%22open%22%7C%22closed%22)%3E"
            }
          ]
        },
        "draft": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3Cboolean%3E"
            }
          ]
        },
        "labels": {
          "$ref": "#/$defs/AuthoringIssueLabels"
        },
        "assignees": {
          "$ref": "#/$defs/AuthoringIssueAssignees"
        },
        "reviewers": {
          "$ref": "#/$defs/AuthoringIssueAssignees",
          "description": "GitHub user logins only; a requested reviewer is not an approving review."
        },
        "closes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Logical IDs of declared issues referenced by a managed Closes #number block."
        },
        "projects": {
          "$ref": "#/$defs/AuthoringProjectAssignments",
          "description": "Project memberships and field values keyed by existing board logicalId."
        }
      },
      "required": [
        "logicalId",
        "head",
        "base"
      ],
      "additionalProperties": false,
      "description": "Managed PR declaration, identified by a unique open head/base pair (or explicit PR number). head and base must be same-repository branch refs, not cross-fork selectors. Existing PRs can change base only when identity.number identifies the original PR."
    },
    "AuthoringSet<boolean>": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "additionalProperties": false,
      "description": "Explicitly assign a value; omitted properties are not managed."
    },
    "AuthoringMilestone": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthoringManagedMilestone"
        },
        {
          "$ref": "#/$defs/AuthoringReferencedMilestone"
        }
      ],
      "description": "Managed or reference-only milestone declaration."
    },
    "AuthoringManagedMilestone": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "managed"
        },
        "identity": {
          "$ref": "#/$defs/AuthoringIdentity"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3Cstring%3E"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSetOrRemove%3Cstring%3E"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "const": "open"
            },
            {
              "type": "string",
              "const": "closed"
            },
            {
              "$ref": "#/$defs/AuthoringSet%3C(%22open%22%7C%22closed%22)%3E"
            }
          ]
        },
        "due_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AuthoringSetOrRemove%3Cstring%3E"
            }
          ],
          "description": "UTC date-only YYYY-MM-DD; explicit remove clears the existing deadline."
        }
      },
      "required": [
        "logicalId"
      ],
      "additionalProperties": false,
      "description": "Managed milestone: title is fallback discovery identity when no explicit id is supplied; omitted fields remain unchanged."
    },
    "AuthoringReferencedMilestone": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "reference"
        },
        "identity": {
          "$ref": "#/$defs/AuthoringIdentity"
        }
      },
      "required": [
        "logicalId",
        "management"
      ],
      "additionalProperties": false,
      "description": "Existing milestone resource used as a pointer, not mutated or created."
    },
    "AuthoringProjectReference": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "ownerType": {
          "type": "string",
          "enum": [
            "org",
            "user"
          ],
          "description": "Organization is default. A user project requires compatible authentication."
        }
      },
      "required": [
        "logicalId",
        "owner",
        "number"
      ],
      "additionalProperties": false,
      "description": "Referenced existing Projects v2 board; project/field creation is deliberately unsupported."
    },
    "AuthoringRepositoryLabel": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthoringManagedRepositoryLabel"
        },
        {
          "$ref": "#/$defs/AuthoringReferencedRepositoryLabel"
        }
      ],
      "description": "Managed or reference-only repository-label declaration, keyed by unique name."
    },
    "AuthoringManagedRepositoryLabel": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "managed"
        },
        "color": {
          "type": "string",
          "description": "Six hexadecimal digits, without #."
        },
        "description": {
          "type": "string",
          "description": "Maximum 100 characters; empty string clears."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Managed repository label: case-insensitive name is identity; metadata is optional and never implies deletion or rename."
    },
    "AuthoringReferencedRepositoryLabel": {
      "type": "object",
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "management": {
          "type": "string",
          "const": "reference"
        }
      },
      "required": [
        "name",
        "management"
      ],
      "additionalProperties": false,
      "description": "Existing label referenced by name only; missing labels block and cannot be created from a reference."
    },
    "AuthoringRelationship": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parent"
            },
            "parent": {
              "type": "string"
            },
            "child": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "parent",
            "child"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "blocked_by"
            },
            "issue": {
              "type": "string"
            },
            "blocker": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issue",
            "blocker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "blocks"
            },
            "issue": {
              "type": "string"
            },
            "blocked": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issue",
            "blocked"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "relates_to"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Directed parent/blocked_by/blocks and symmetric relates_to edges. blocks reverses blocked_by; relates_to is deduplicated without direction."
    }
  }
}
